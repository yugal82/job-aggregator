ENV=development
LOG_LEVEL=INFO

# Local docker-compose default. On Neon in prod, set:
#   DATABASE_URL=<direct URL — used by Alembic migrations only>
#   DATABASE_POOLED_URL=<pgbouncer URL — used by runtime queries>
DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs
# DATABASE_POOLED_URL=
TEST_DATABASE_URL=postgresql+asyncpg://jobs:jobs@localhost:5432/jobs_test

# CORS: comma-separated frontend origins. In prod add the deployed origin:
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LLM_API_KEY=
